# Match your host user/group so container-created files belong to you.
DOCKERCOMPOSE_UID=1001
DOCKERCOMPOSE_GID=1001

# Set the UUID of this machine's RTX 5070 Ti or RTX 5050 (including Laptop GPU).
# Find it with: nvidia-smi --query-gpu=name,uuid --format=csv,noheader
# Select exactly one GPU. Do not select the RTX 3060.
NVIDIA_GPU_DEVICE_ID=
